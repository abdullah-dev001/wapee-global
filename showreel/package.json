{
  "name": "wapee-showreel",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Remotion explainer video. Not part of the product build.",
  "scripts": {
    "studio": "remotion studio",
    "render": "node scripts/render.mjs",
    "render:4k": "node scripts/render.mjs --scale=2",
    "stills": "node scripts/stills.mjs",
    "sfx": "python3 scripts/make-sfx.py",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node scripts/verify.mjs",
    "profile": "node scripts/profile.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@remotion/cli": "4.0.533",
    "lucide-react": "1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
