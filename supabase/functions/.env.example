# Edge Function secrets. NAMES ONLY. Never commit real values.
# Local: copy to supabase/functions/.env and run `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set NAME=value`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into hosted Edge Functions; the service role key must never reach the app.

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Web Push (VAPID) — the public key also goes in the app as EXPO_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Expo push (optional, for enhanced push security)
EXPO_ACCESS_TOKEN=
