# Edge Function secrets. NAMES ONLY. Never commit real values.
# Local: copy to supabase/functions/.env and run `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set NAME=value`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into hosted Edge Functions; the service role key must never reach the app.

# Public endpoint protection (Phase 3 step 7). BOTH ARE REQUIRED by get_slots,
# create_booking and manage_booking: the code THROWS rather than falling back to
# a default, because a constant salt would make every IP hash guessable.
#   supabase secrets set PUBLIC_IP_HASH_SALT="$(openssl rand -hex 32)"
#   supabase secrets set PUBLIC_FORM_HMAC_KEY="$(openssl rand -hex 32)"
# Rotating PUBLIC_IP_HASH_SALT resets every rate-limit window (accepted cost).
# Rotating PUBLIC_FORM_HMAC_KEY invalidates start tokens in flight, so a customer
# mid-booking has to reload the form once.
PUBLIC_IP_HASH_SALT=
PUBLIC_FORM_HMAC_KEY=

# Origins allowed to call the public endpoints (comma-separated). Without it the
# placeholder domains from src/config/brand.ts plus localhost are used.
PUBLIC_SITE_ORIGINS=
# Base URL used to build the guest manage link in resend_manage_link.
PUBLIC_SITE_URL=

# Email (Resend) — used by send_outbox. RESEND_FROM_EMAIL is the display + address,
# e.g. "Bookings <no-reply@mail.example.com>" (one platform sender for now).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Signs the one-click unsubscribe links in reminder / review emails (HMAC-SHA256).
#   supabase secrets set UNSUBSCRIBE_SIGNING_KEY="$(openssl rand -hex 32)"
# Rotating it invalidates unsubscribe links already sent (accepted).
UNSUBSCRIBE_SIGNING_KEY=

# SMS (Twilio) — used by send_outbox. Set EITHER the messaging service OR a from number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Web Push (VAPID) — the public key also goes in the app as EXPO_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Expo push (optional, for enhanced push security)
EXPO_ACCESS_TOKEN=
