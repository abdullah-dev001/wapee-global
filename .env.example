# Copy this file to .env and fill in the values.
# EXPO_PUBLIC_* values are bundled into the app and visible to users.
# NEVER put secrets here (service role key, Twilio, Resend, VAPID private key).
# Server secrets go in supabase/functions/.env (see supabase/functions/.env.example).

# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (PWA) public VAPID key
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# The single origin (landing, dashboard, admin, business pages, email links). Default in src/config/brand.ts.
EXPO_PUBLIC_SITE_URL=https://wapee.online

# "Continue with Google" on login / signup: 1 = shown. Leave empty on production until the
# Google provider is set up there (docs/production-setup.md). Dev / preview builds: 1.
EXPO_PUBLIC_GOOGLE_SIGNIN=
