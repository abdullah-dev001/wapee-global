# Cloudflare Pages redirects. Static files always win over these rules.
# Static export gives one HTML file per route; dynamic routes ([slug], [id]) need a rewrite (200)
# to their template file. Pages serves X.html at /X (pretty URLs), so targets have no ".html".
# Static pages that resolve by themselves (no rule needed): /unsubscribe, /accept-invite,
# /delete-account, /privacy, /terms, /report-print, /login, /signup, ...

# Business public pages (slug is one segment)
/:slug/book     /[slug]/book     200
/:slug/manage   /[slug]/manage   200
/:slug/review   /[slug]/review   200
/:slug/sign     /[slug]/sign     200
/:slug/portal   /[slug]/portal   200

# Dashboard / admin / print dynamic routes
/clients/:id           /clients/[id]            200
/invoice-print/:id     /invoice-print/[id]      200
/admin/business/:id    /admin/business/[id]     200

# Business website: /<slug> (last, so any real page above it wins)
/:slug   /[slug]   200

# SPA fallback: any other path loads the app shell, which shows its own not-found screen.
# "/" (index.html) is the static landing page; the Expo shell is kept at /_app/shell (scripts/build-landing.mjs).
/*   /_app/shell   200
