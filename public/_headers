# Cloudflare Pages headers. Rules MERGE (a header set by two matching rules is sent twice),
# so a specific rule first removes the general value with "! Header-Name".

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://exp.host; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Booking page: the only page allowed in a frame (same origin only; the embed widget is off at launch)
/:slug/book
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

# Pages that carry a token in the URL fragment: never send a referrer
/:slug/manage
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/:slug/review
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/:slug/sign
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/:slug/portal
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/unsubscribe
  ! Referrer-Policy
  Referrer-Policy: no-referrer

# Caching
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=3600
