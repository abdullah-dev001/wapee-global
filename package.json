{
  "name": "wapee",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "start": "expo start",
    "prestart": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-web-manifest.mjs",
    "web": "expo start --web",
    "preweb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-web-manifest.mjs",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "prebuild:web": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/build-landing.mjs --check-env && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-web-manifest.mjs && node scripts/strip-dev-routes.mjs",
    "manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-web-manifest.mjs",
    "postbuild:web": "node scripts/strip-dev-routes.mjs --restore && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/build-landing.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:public": "node scripts/smoke-public.mjs",
    "check:migrations": "bash scripts/check-migrations.sh",
    "guide:check": "node scripts/check-guide.mjs"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
