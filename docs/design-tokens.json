{
  "$meta": {
    "name": "Wapee Design Tokens",
    "source": "src/globals.css (:root, lines 9-146) unless noted",
    "darkMode": "NOT DEFINED IN CODE",
    "rootFontSize": { "default": "16px (browser default)", "mobile": "15px (max-width: 767.98px)" },
    "note": "Values are exact copies from the code. 'usage' entries are literal values found in components, not CSS variables."
  },
  "colors": {
    "light": {
      "brand": {
        "primary": "#024751",
        "primary-hover": "#013640",
        "primary-light": "#e6f0f2",
        "secondary": "#d8ff29",
        "secondary-hover": "#c4eb1a",
        "secondary-light": "#f6ffd6"
      },
      "surface": {
        "background": "#f8fafb",
        "surface": "#ffffff",
        "surface-hover": "#f3f4f6",
        "border": "#e5e7eb",
        "border-subtle": "#f0f0f0"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#4b5563",
        "muted": "#6b7280",
        "on-primary": "#ffffff",
        "on-secondary": "#024751"
      },
      "sidebar": {
        "bg": "#024751",
        "text": "#a8c5ca",
        "active": "#d8ff29",
        "active-text": "#024751",
        "hover": "#035f6e"
      },
      "status": {
        "success": { "base": "#10b981", "light": "#ecfdf5", "border": "#a7f3d0" },
        "warning": { "base": "#f59e0b", "light": "#fffbeb", "border": "#fde68a" },
        "error": { "base": "#ef4444", "hover": "#dc2626", "light": "#fef2f2", "border": "#fecaca" },
        "info": { "base": "#3b82f6", "light": "#eff6ff", "border": "#bfdbfe" }
      },
      "misc": {
        "overlay": "rgba(0, 0, 0, 0.5)",
        "locked-scrim-top": "rgba(248, 250, 251, 0.72)",
        "locked-scrim-bottom": "rgba(248, 250, 251, 0.92)",
        "focus-ring": "0 0 0 3px var(--color-primary-light) (literal in Input/Textarea/Select, not a token)"
      },
      "portfolioLoader": {
        "bg": "#1a1a1a",
        "track": "rgba(255, 255, 255, 0.12)",
        "sweep": "linear-gradient(90deg, rgba(216, 255, 41, 0) 0%, rgba(216, 255, 41, 0.85) 50%, rgba(216, 255, 41, 0) 100%)",
        "glow": "radial-gradient(60rem 32rem at 50% 42%, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0) 70%)"
      },
      "adminShell_hardcoded": {
        "$source": "src/components/admin/AdminLayout.jsx, AdminAccountSection.jsx (literal hex, no tokens)",
        "sidebar-bg": "#0F172A",
        "divider": "#1E293B",
        "nav-text": "#94A3B8",
        "label": "#64748B",
        "name": "#E2E8F0",
        "error-text": "#FCA5A5",
        "wordmark": "#FFFFFF",
        "active-bg": "#D8FF29",
        "active-text": "#0F172A"
      },
      "chart": "NOT DEFINED IN CODE"
    },
    "dark": "NOT DEFINED IN CODE"
  },
  "opacity": {
    "$source": "literal in components",
    "disabled": 0.55,
    "disabled-pagination-arrow": 0.45,
    "disabled-tag-add": 0.5,
    "refetching-list": 0.6,
    "skeleton-pulse-min": 0.45
  },
  "typography": {
    "fontFamily": {
      "sans": "'DM Sans', ui-sans-serif, system-ui, -apple-system, sans-serif"
    },
    "fontLoading": {
      "provider": "Google Fonts <link> in index.html",
      "url": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,400&display=swap",
      "weightsLoaded": "300-700 (variable), italic 400",
      "smoothing": "-webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale"
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "tighter": "-0.03em",
      "portfolio-label": "0.08em"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "headingsDefault": 600
    },
    "fontSize_usage": {
      "$note": "No font-size tokens exist; these are the literal rem values in use",
      "2xs": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "md": "0.9375rem",
      "lg": "1rem",
      "xl": "1.0625rem",
      "2xl": "1.375rem",
      "3xl": "1.5rem",
      "4xl": "2rem",
      "display": "3.25rem"
    },
    "lineHeight_usage": {
      "$note": "No line-height tokens exist (except portfolio)",
      "tight": 1.15,
      "button": 1.2,
      "badge": 1.3,
      "snug": 1.45,
      "normal": 1.5,
      "relaxed": 1.55,
      "loose": 1.6,
      "portfolio-body": 1.6
    },
    "roles": {
      "pageTitle": { "fontSize": "1.5rem", "fontSizeMobile": "1.25rem", "fontWeight": 600, "letterSpacing": "-0.03em", "color": "text.primary" },
      "pageSubtitle": { "fontSize": "0.875rem", "color": "text.secondary" },
      "cardTitle": { "fontSize": "1rem", "fontWeight": 600, "letterSpacing": "-0.03em" },
      "drawerTitle": { "fontSize": "1rem", "fontWeight": 600, "letterSpacing": "-0.02em" },
      "authTitle": { "fontSize": "1.375rem", "fontWeight": 600, "letterSpacing": "-0.03em" },
      "itemTitle": { "fontSize": "0.9375rem", "fontWeight": 600 },
      "body": { "fontSize": "0.875rem", "fontWeight": 400 },
      "label": { "fontSize": "0.8125rem", "fontWeight": 600, "color": "text.primary" },
      "hint": { "fontSize": "0.75rem", "color": "text.secondary" },
      "error": { "fontSize": "0.75rem", "color": "status.error.base" },
      "buttonSm": { "fontSize": "0.8125rem", "fontWeight": 600, "lineHeight": 1.2 },
      "buttonMd": { "fontSize": "0.875rem", "fontWeight": 600, "lineHeight": 1.2 },
      "buttonLg": { "fontSize": "0.9375rem", "fontWeight": 600, "lineHeight": 1.2 },
      "badge": { "fontSize": "0.6875rem", "fontWeight": 600, "lineHeight": 1.3 },
      "tableHeader": { "fontSize": "0.75rem", "fontWeight": 600, "textTransform": "uppercase", "color": "text.muted" },
      "tableCell": { "fontSize": "0.875rem", "fontWeight": 400 },
      "statValue": { "fontSize": "1.5rem", "fontSizeMobile": "1.25rem", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.03em" },
      "statLabel": { "fontSize": "0.8125rem", "fontSizeMobile": "0.75rem", "color": "text.secondary" },
      "headlineNumber": { "fontSize": "2rem", "fontSizeMobile": "1.75rem", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.03em" },
      "landingHero": { "fontSize": "3.25rem", "fontSizeMobile": "2.125rem", "fontWeight": 600, "lineHeight": 1.1, "letterSpacing": "-0.03em" }
    }
  },
  "spacing": {
    "scale_usage": {
      "$note": "No spacing tokens exist; literal rem values observed",
      "values": ["0.125rem", "0.1875rem", "0.25rem", "0.3125rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "0.875rem", "1rem", "1.25rem", "1.5rem", "2rem", "2.5rem", "3rem"]
    },
    "layout": {
      "page-padding": "1.5rem",
      "page-padding-mobile": "1rem",
      "card-padding": "1.5rem",
      "card-padding-mobile": "1.125rem",
      "sidebar-width": "240px",
      "header-height": "64px",
      "drawer-width": "480px"
    },
    "patterns": {
      "formFieldGap": "1rem",
      "labelToControlGap": "0.375rem",
      "cardGridGap": "1rem",
      "statGridGap": "1rem (mobile 0.75rem)",
      "sectionGridGap": "1.5rem (mobile 1rem)",
      "pageHeaderMarginBottom": "1.5rem",
      "filterBarMarginBottom": "1.25rem",
      "buttonGroupGap": "0.5rem",
      "innerCardBodyPadding": "1rem",
      "drawerHeaderPadding": "1.125rem 1.25rem",
      "drawerBodyPadding": "1.25rem",
      "drawerFooterPadding": "1rem 1.25rem",
      "dialogPadding": "1.5rem",
      "inputPadding": "0.625rem 0.75rem",
      "navItemPadding": "0.625rem 0.875rem"
    }
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px",
    "$usage": {
      "button": "md",
      "input": "md",
      "card": "lg",
      "dialog": "lg",
      "drawer": "0",
      "badge": "full",
      "avatarUser": "full",
      "avatarBusiness": "md",
      "skeletonLine": "sm"
    },
    "portfolioPresets": { "none": "0", "small": "0.25rem", "medium": "0.75rem", "large": "1.5rem" }
  },
  "borders": {
    "width": "1px",
    "widthAccent": "2px (active tab underline, spinners, focus outline)",
    "style": "solid",
    "styleUpload": "dashed",
    "default": "var(--color-border)",
    "subtle": "var(--color-border-subtle)",
    "focus": "var(--color-primary)",
    "error": "var(--color-error)"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(17, 24, 39, 0.05)",
    "md": "0 4px 6px -1px rgba(17, 24, 39, 0.07), 0 2px 4px -2px rgba(17, 24, 39, 0.05)",
    "lg": "0 10px 15px -3px rgba(17, 24, 39, 0.08), 0 4px 6px -4px rgba(17, 24, 39, 0.05)",
    "drawer": "-8px 0 24px -4px rgba(17, 24, 39, 0.12)",
    "focusRing": "0 0 0 3px var(--color-primary-light)",
    "focusOutline": "outline: 2px solid var(--color-primary); outline-offset: 2px"
  },
  "breakpoints": {
    "mobile": 768,
    "tablet": 1024,
    "media": {
      "mobile": "(max-width: 767.98px)",
      "tablet": "(min-width: 768px) and (max-width: 1024px)",
      "desktop": "(min-width: 1024.02px)",
      "compact": "(max-width: 1024px)"
    }
  },
  "containers_usage": {
    "$note": "No container tokens; literal max-widths",
    "auth-card": "25rem",
    "dialog": "26rem",
    "settings-column": "48rem",
    "upsell-card": "52rem",
    "landing": "64rem"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms"
    },
    "easing": "ease",
    "transition": {
      "fast": "120ms ease",
      "base": "180ms ease",
      "slow": "260ms ease"
    },
    "animations": {
      "skeletonPulse": "wapee-pulse 1.4s ease-in-out infinite",
      "overlayFadeIn": "wapee-fade-in var(--transition-base)",
      "drawerSlideIn": "wapee-slide-in-right var(--transition-slow)",
      "spinner": "wapee-spin 600ms linear infinite",
      "spinnerSlow": "wapee-spin 900ms linear infinite",
      "rowIn": "wapee-row-in var(--transition-base)"
    },
    "keyframes": {
      "wapee-pulse": { "0%, 100%": { "opacity": 1 }, "50%": { "opacity": 0.45 } },
      "wapee-fade-in": { "from": { "opacity": 0 }, "to": { "opacity": 1 } },
      "wapee-slide-in-right": { "from": { "transform": "translateX(100%)" }, "to": { "transform": "translateX(0)" } },
      "wapee-spin": { "to": { "transform": "rotate(360deg)" } },
      "wapee-row-in": { "from": { "opacity": 0, "transform": "translateY(-0.25rem)" }, "to": { "opacity": 1, "transform": "translateY(0)" } }
    },
    "reducedMotion": "animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important;",
    "pressState": "NOT DEFINED IN CODE"
  },
  "zIndex": {
    "header": 30,
    "sidebar": 40,
    "overlay": 50,
    "drawer": 60,
    "toast": 70
  },
  "icons": {
    "library": "lucide-react",
    "secondary": "react-icons/fa (social brand icons only)",
    "defaultStrokeWidth": 1.75,
    "strokeWidths": { "default": 1.75, "smallUi": 2, "tinyMark": 2.5, "placeholder": 1.5, "illustration": 1.25 },
    "sizes": { "badge": 11, "tiny": 13, "cardAction": 14, "search/sidebar": 15, "button": 16, "drawerClose": 18, "sidebarClose": 20, "tile": 22 },
    "color": "currentColor; decorative-in-input = text.muted; tile = primary on primary-light"
  },
  "components": {
    "button": {
      "radius": "var(--radius-md)",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "gap": "0.5rem",
      "border": "1px solid",
      "sizes": {
        "sm": { "padding": "0.5rem 0.875rem", "fontSize": "0.8125rem" },
        "md": { "padding": "0.6875rem 1.125rem", "fontSize": "0.875rem" },
        "lg": { "padding": "0.875rem 1.5rem", "fontSize": "0.9375rem" }
      },
      "variants": {
        "primary": { "bg": "primary", "text": "text.on-primary", "border": "primary", "hoverBg": "primary-hover", "hoverBorder": "primary-hover" },
        "secondary": { "bg": "secondary", "text": "text.on-secondary", "border": "secondary", "hoverBg": "secondary-hover", "hoverBorder": "secondary-hover" },
        "ghost": { "bg": "transparent", "text": "text.primary", "border": "border", "hoverBg": "surface-hover", "hoverBorder": "text.muted" },
        "danger": { "bg": "error", "text": "text.on-primary", "border": "error", "hoverBg": "error-hover", "hoverBorder": "error-hover" }
      },
      "disabledOpacity": 0.55
    },
    "input": {
      "padding": "0.625rem 0.75rem",
      "fontSize": "0.875rem",
      "radius": "var(--radius-md)",
      "border": "1px solid var(--color-border)",
      "focusBorder": "var(--color-primary)",
      "focusRing": "0 0 0 3px var(--color-primary-light)",
      "errorBorder": "var(--color-error)",
      "disabledBg": "var(--color-surface-hover)",
      "selectPaddingRight": "2.25rem",
      "textareaRows": 4,
      "textareaLineHeight": 1.5
    },
    "toggle": { "track": "2.25rem x 1.25rem", "thumb": "0.875rem", "inset": "0.1875rem", "on": "primary", "off": "border" },
    "card": { "bg": "surface", "border": "1px solid var(--color-border)", "radius": "var(--radius-lg)", "padding": "var(--card-padding)", "shadow": "none", "hoverBorder": "primary", "hoverShadow": "var(--shadow-md)" },
    "badge": { "padding": "0.1875rem 0.5rem", "fontSize": "0.6875rem", "fontWeight": 600, "radius": "full", "dot": "0.375rem" },
    "dialog": { "maxWidth": "26rem", "padding": "1.5rem", "radius": "lg", "shadow": "lg" },
    "drawer": { "width": "480px", "widthMobile": "100%", "shadow": "drawer" },
    "pagination": { "buttonSize": "2rem", "radius": "md", "activeBg": "primary" },
    "tabs": { "padding": "0.75rem 1rem", "activeUnderline": "2px solid var(--color-primary)" },
    "sidebarItem": { "padding": "0.625rem 0.875rem", "radius": "md", "fontSize": "0.875rem", "activeBg": "sidebar.active", "activeText": "sidebar.active-text", "hoverBg": "sidebar.hover", "hoverText": "text.on-primary" },
    "table": { "cellPadding": "0.75rem 1rem", "minWidth": "44rem", "rowBorder": "1px solid var(--color-border-subtle)", "rowHoverBg": "surface-hover" },
    "skeleton": { "bg": "surface-hover", "animation": "wapee-pulse 1.4s ease-in-out infinite", "lineRadius": "sm" },
    "emptyState": { "iconCircle": "2.75rem", "padding": "2.5rem 1rem", "paddingCompact": "1.5rem 1rem", "descriptionMaxWidth": "22rem" }
  }
}
